/* ═════════════════════════════════════════════════════════════
   JIMMY — PRODUCTION DARK TERMINAL THEME
   ═════════════════════════════════════════════════════════════ */

/* Global */
Screen {
    background: #020408;
    color: #d8dee9;
}

/* Mode visibility */
Screen.landing #topbar,
Screen.landing #chat-main {
    display: none;
}

Screen.chat #landing-main {
    display: none;
}

/* Landing */
#landing-main {
    width: 100%;
    height: 100%;
    align: center top;
    layout: vertical;
    background: #020408;
    padding-top: 4;
}

#logo-large {
    width: 100%;
    height: auto;
    color: #22d3ee;
    text-style: bold;
    content-align: center middle;
}

#tagline {
    width: 100%;
    height: 1;
    margin-top: 1;
    margin-bottom: 0;
    color: #94a3b8;
    content-align: center middle;
}

#input-wrapper {
    width: 100%;
    height: auto;
    align: center middle;
    margin-top: 2;
    margin-bottom: 1;
}

#prompt-landing {
    width: 80;
    height: 3;
    background: #0a0f16;
    color: #e0f2fe;
    border: solid #22d3ee;
    padding: 0 2;
    transition: border 0.2s, background 0.2s;
}

#prompt-landing:focus {
    background: #0d1520;
    color: #f0f9ff;
    border: solid #67e8f9;
}

#recent-sessions-wrapper {
    width: 100%;
    height: auto;
    align: center top;
    margin-top: 1;
    margin-bottom: 0;
}

.view-all-link {
    width: auto;
    height: 1;
    color: #22d3ee;
    content-align: center middle;
    text-style: dim;
}

.view-all-link:hover {
    text-style: bold;
    color: #67e8f9;
}

/* Session rows */
.session-row {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    layout: horizontal;
}

.session-row .delete-button {
    width: 3;
    height: auto;
    color: #ef4444;
    content-align: center middle;
    text-style: bold;
}

.session-row .delete-button:hover {
    color: #f87171;
    text-style: bold reverse;
}

/* Top bar */
#topbar {
    dock: top;
    width: 100%;
    height: 1;
    background: #020408;
    color: #d8dee9;
    padding: 0 1;
}

#brand {
    width: auto;
    color: #22d3ee;
    content-align: left middle;
}

#project {
    width: auto;
    color: #60a5fa;
    content-align: left middle;
    padding: 0 1;
}

#session-indicator {
    width: auto;
    color: #c4b5fd;
    content-align: left middle;
    padding: 0 1;
}

#file-context {
    width: 1fr;
    color: #fbbf24;
    content-align: left middle;
    padding: 0 1;
}

#permission-mode {
    width: auto;
    color: #fbbf24;
    content-align: left middle;
    padding: 0 1;
}

#status-indicator {
    width: auto;
    color: #c4b5fd;
    content-align: left middle;
    padding: 0 1;
}

#datetime {
    width: auto;
    color: #64748b;
    content-align: right middle;
    padding: 0 1;
}

#clock {
    width: 12;
    color: #22d3ee;
    content-align: right middle;
}

/* Chat */
#chat-main {
    width: 100%;
    height: 100%;
    layout: vertical;
    background: #020408;
}

#conversation {
    width: 100%;
    height: 1fr;
    background: #020408;
    color: #d8dee9;
    border: none;
    padding: 0 1;
    scrollbar-size: 0 0;
}

#typing-indicator {
    width: 100%;
    height: 1;
    background: #020408;
    color: #64748b;
    content-align: left middle;
    padding: 0 2;
    text-style: dim;
}

#prompt-chat {
    width: 100%;
    height: 3;
    background: #0a0f16;
    color: #e0f2fe;
    border: solid #1e293b;
    padding: 0 1;
    transition: border 0.2s, background 0.2s;
}

#prompt-chat:focus {
    background: #0d1520;
    color: #f0f9ff;
    border: solid #22d3ee;
}

#prompt-chat.-disabled {
    opacity: 0.35;
}

/* Observability & actions */
#observability,
#typing-indicator,
#chat-actions {
    background: transparent;
}

#observability {
    border: none;
    padding: 0 1;
}

#chat-actions {
    width: 100%;
    height: 1;
    align: right middle;
    padding: 0 1;
}

#copy-conversation {
    width: 10;
    height: 1;
    min-width: 10;
    background: transparent;
    border: none;
    color: #64748b;
    padding: 0 1;
}

#copy-conversation:hover,
#copy-conversation:focus {
    color: #22d3ee;
    background: transparent;
    text-style: bold;
}

#streaming-response {
    display: none;
    width: 100%;
    height: auto;
    margin: 0 1;
    padding: 0 1;
    background: transparent;
    color: #d8dee9;
}

/* Help */
HelpScreen {
    align: center middle;
    background: #020408;
}

#help-box {
    width: 80;
    height: auto;
    background: #0b1017;
    border: solid #22d3ee;
    padding: 1 2;
}

#help-text {
    color: #d8dee9;
}

/* Footer */
Footer {
    width: 100%;
    height: 1;
    background: #020408;
    color: #475569;
}

Footer > .footer--key {
    color: #ef4444;
}

Footer > .footer--description {
    color: #64748b;
}

/* General */
RichLog {
    scrollbar-size: 1 1;
}

.selection {
    background: #164e63;
    color: #ecfeff;
}

/* All Sessions Dialog */
AllSessionsScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0);
}

#all-sessions-dialog {
    width: 72;
    max-width: 90%;
    height: 80%;
    max-height: 30;
    background: #0b1017;
    border: solid #22d3ee;
    padding: 1 2;
}

#all-sessions-title {
    height: 1;
    margin-bottom: 1;
    color: #f8fafc;
    text-style: bold;
    content-align: center middle;
}

#all-sessions-list {
    width: 100%;
    height: 1fr;
    overflow-y: auto;
    scrollbar-size: 1 1;
    scrollbar-background: #020408;
    scrollbar-color: #1e293b;
    scrollbar-color-hover: #334155;
    scrollbar-color-active: #22d3ee;
}

.all-session-card {
    width: 1fr;
    height: auto;
    padding: 1 1;
    margin: 0 0 1 0;
    background: #0b1017;
    border: solid #1e293b;
    content-align: left middle;
}

.all-session-card:hover {
    background: #111827;
    border: solid #334155;
}

.all-session-card.selected {
    background: #164e63;
    border: solid #22d3ee;
}

.all-session-card:focus {
    border: solid #67e8f9;
}

#all-sessions-footer {
    height: 1;
    margin-top: 1;
    color: #475569;
    content-align: center middle;
    text-style: dim;
}

/* Permission overlays */
PermissionScreen,
PermissionPrompt {
    align: center middle;
    background: rgba(0, 0, 0, 0);
}

/* Permission mode dialog */
#permission-dialog {
    width: 72;
    height: auto;
    padding: 1 2;
    background: transparent;
    border: round #334155;
}

#permission-title {
    height: 1;
    margin-bottom: 1;
    color: #f8fafc;
    text-style: bold;
}

#permission-subtitle {
    height: 1;
    margin-bottom: 1;
    color: #64748b;
}

#permission-options {
    height: auto;
    padding: 0 0 1 0;
    color: #cbd5e1;
}

#permission-footer {
    height: 1;
    margin-top: 1;
    color: #475569;
    content-align: center middle;
}

/* Permission approval dialog */
#approval-dialog {
    width: 66;
    height: auto;
    padding: 1 2;
    background: transparent;
    border: round #f59e0b;
}

#approval-title {
    height: 1;
    margin-bottom: 1;
    color: #f8fafc;
    text-style: bold;
}

#approval-tool {
    height: auto;
    padding: 1;
    margin-bottom: 1;
    background: #111827;
    color: #cbd5e1;
}

#approval-reason {
    height: auto;
    margin-bottom: 1;
    color: #94a3b8;
}

#approval-actions {
    width: 100%;
    height: 3;
    align: center middle;
}

#approval-allow {
    width: 20;
    height: 3;
    margin-right: 1;
    background: #14532d;
    color: #dcfce7;
    content-align: center middle;
    text-style: bold;
}

#approval-allow:hover,
#approval-allow:focus {
    background: #166534;
    color: #f0fdf4;
}

#approval-deny {
    width: 20;
    height: 3;
    margin-right: 1;
    background: #3f1d1d;
    color: #fecaca;
    content-align: center middle;
    text-style: bold;
}

#approval-deny:hover,
#approval-deny:focus {
    background: #7f1d1d;
    color: #fee2e2;
}

#approval-full {
    width: 20;
    height: 3;
    background: #1e293b;
    color: #fde68a;
    content-align: center middle;
    text-style: bold;
}

#approval-full:hover,
#approval-full:focus {
    background: #334155;
    color: #fef3c7;
}

#approval-footer {
    height: 1;
    margin-top: 1;
    color: #475569;
    content-align: center middle;
}

/* Delete confirm dialog */
DeleteConfirmScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0);
}

#delete-dialog {
    width: 40;
    height: auto;
    background: transparent;
    border: round #ef4444;
    padding: 1 2;
}

#delete-title {
    height: 1;
    margin-bottom: 1;
    color: #f8fafc;
    text-style: bold;
    content-align: center middle;
}

#delete-actions {
    width: 100%;
    height: 3;
    align: center middle;
}

#delete-confirm {
    width: 16;
    height: 3;
    margin-right: 1;
    background: #7f1d1d;
    color: #fee2e2;
    content-align: center middle;
    text-style: bold;
}

#delete-confirm:hover,
#delete-confirm:focus {
    background: #991b1b;
    color: #fef2f2;
}

#delete-cancel {
    width: 16;
    height: 3;
    background: #1e293b;
    color: #cbd5e1;
    content-align: center middle;
    text-style: bold;
}

#delete-cancel:hover,
#delete-cancel:focus {
    background: #334155;
    color: #f1f5f9;
}
