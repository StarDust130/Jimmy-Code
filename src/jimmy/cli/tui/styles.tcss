Screen {
    background: #0b0d0f;
    color: #d6d9dd;
}

#topbar {
    dock: top;
    height: 3;

    background: #0b0d0f;

    border-bottom: solid #30363d;

    padding: 0 2;
}

#brand {
    width: 1fr;
    content-align: left middle;
}

#project {
    width: auto;
    color: #7d8792;
    content-align: right middle;
    padding: 0 2;
}

#clock {
    width: 8;
    color: #adb5bd;
    content-align: right middle;
}

#main {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

#logo {
    height: 8;
    color: #e3e6e8;
    padding: 0 1;
}

#status {
    height: 2;
    padding: 0 1;
    content-align: left middle;
    border-bottom: solid #272d32;
}

#activity {
    width: 100%;
    height: 1fr;

    background: #0b0d0f;

    border: solid #30363d;

    padding: 1;

    scrollbar-size: 1 1;
    scrollbar-background: #0b0d0f;
    scrollbar-color: #3b434b;
}

#prompt {
    width: 100%;
    height: 3;

    margin-top: 1;

    border: solid #30363d;

    background: #101316;

    color: #e0e3e6;

    padding: 0 1;
}

#prompt:focus {
    border: solid #707982;
}

#prompt.-disabled {
    opacity: 0.5;
}

Footer {
    height: 1;

    background: #111418;
    color: #707982;
}

Footer > .footer--key {
    color: #d0d5da;
}

Footer > .footer--description {
    color: #707982;
}