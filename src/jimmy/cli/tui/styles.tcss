/* ═════════════════════════════════════════════════════════════
   DARK ONLY  —  Deep space terminal aesthetic
   ═════════════════════════════════════════════════════════════ */

Screen {
    background: #020408;
    color: #d8dee9;
}

/* ═════════════════════════════════════════════════════════════
   MODE VISIBILITY
   ═════════════════════════════════════════════════════════════ */

Screen.landing #topbar {
    display: none;
}

Screen.landing #chat-main {
    display: none;
}

Screen.chat #landing-main {
    display: none;
}

/* ═════════════════════════════════════════════════════════════
   LANDING SCREEN
   ═════════════════════════════════════════════════════════════ */

#landing-main {
    width: 100%;
    height: 100%;
    align: center middle;
    layout: vertical;
    background: #020408;
}

#logo-large {
    height: auto;
    color: #22d3ee;
    text-style: bold;
    content-align: center middle;
}

#tagline {
    height: 1;
    margin-top: 1;
    color: #94a3b8;
    content-align: center middle;
}

#sysinfo {
    height: 1;
    margin-top: 1;
    color: #475569;
    content-align: center middle;
    text-style: dim;
}

#input-wrapper {
    width: 100%;
    height: auto;
    align: center middle;
    margin-top: 2;
}

#prompt-landing {
    width: 80;
    height: 3;
    background: #0a0f16;
    color: #e0f2fe;
    border: solid #22d3ee;
    padding: 0 2;
}

#prompt-landing:focus {
    background: #0d1520;
    color: #f0f9ff;
    border: solid #67e8f9;
}

#landing-footer {
    height: 1;
    margin-top: 2;
    color: #334155;
    content-align: center middle;
    text-style: dim;
}

/* ═════════════════════════════════════════════════════════════
   TOP BAR
   ═════════════════════════════════════════════════════════════ */

#topbar {
    dock: top;
    height: 1;
    background: #020408;
    color: #d8dee9;
    padding: 0 1;
}

#brand {
    width: auto;
    color: #22d3ee;
    content-align: left middle;
}

#project {
    width: auto;
    color: #60a5fa;
    content-align: left middle;
    padding: 0 1;
}

#git-branch {
    width: auto;
    color: #4ade80;
    content-align: left middle;
    padding: 0 1;
}

#file-context {
    width: 1fr;
    color: #fbbf24;
    content-align: left middle;
    padding: 0 1;
}

#status-indicator {
    width: auto;
    color: #c4b5fd;
    content-align: left middle;
    padding: 0 1;
}

#datetime {
    width: auto;
    color: #64748b;
    content-align: right middle;
    padding: 0 1;
}

#clock {
    width: 12;
    color: #22d3ee;
    content-align: right middle;
}

/* ═════════════════════════════════════════════════════════════
   CHAT SCREEN
   ═════════════════════════════════════════════════════════════ */

#chat-main {
    width: 100%;
    height: 100%;
    layout: vertical;
    background: #020408;
}

#conversation {
    width: 100%;
    height: 1fr;
    background: #070a0f;
    color: #d8dee9;
    border: none;
    padding: 0 1;
    scrollbar-size: 1 1;
    scrollbar-background: #070a0f;
    scrollbar-color: #1e293b;
    scrollbar-color-hover: #334155;
    scrollbar-color-active: #22d3ee;
}

#typing-indicator {
    height: 1;
    background: #020408;
    color: #64748b;
    content-align: left middle;
    padding: 0 2;
    text-style: dim;
}

#prompt-chat {
    width: 100%;
    height: 3;
    background: #0a0f16;
    color: #e0f2fe;
    border: solid #1e293b;
    padding: 0 1;
}

#prompt-chat:focus {
    background: #0d1520;
    color: #f0f9ff;
    border: solid #22d3ee;
}

#prompt-chat.-disabled {
    opacity: 0.35;
}

/* ═════════════════════════════════════════════════════════════
   HELP SCREEN
   ═════════════════════════════════════════════════════════════ */

HelpScreen {
    align: center middle;
    background: #020408;
}

#help-box {
    width: 80;
    height: auto;
    background: #0b1017;
    border: solid #22d3ee;
    padding: 1 2;
}

#help-text {
    color: #d8dee9;
}

#help-footer {
    height: 1;
    margin-top: 1;
    color: #475569;
    content-align: center middle;
    text-style: dim;
}

/* ═════════════════════════════════════════════════════════════
   FOOTER
   ═════════════════════════════════════════════════════════════ */

Footer {
    height: 1;
    background: #020408;
    color: #475569;
}

Footer > .footer--key {
    color: #fbbf24;
}

Footer > .footer--description {
    color: #64748b;
}

/* ═════════════════════════════════════════════════════════════
   GENERAL
   ═════════════════════════════════════════════════════════════ */

RichLog {
    scrollbar-size: 1 1;
}

.selection {
    background: #164e63;
    color: #ecfeff;
}
/* =========================================================
   PERMISSION OVERLAYS
   Transparent overlay so the existing terminal stays visible.
   Both permission screens appear as centered dialogs.
   ========================================================= */

PermissionScreen,
PermissionPrompt {
    align: center middle;
    background: #000000 0%;
}


/* =========================================================
   PERMISSION MODE DIALOG
   Ctrl+P → Ask / Full Access / Safe Only
   ========================================================= */

#permission-dialog {
    width: 64;
    height: auto;
    min-height: 12;
    padding: 1 2;

    background: #0b1220;
    border: round #334155;
}

#permission-title {
    height: 1;
    margin-bottom: 1;

    color: #f8fafc;
    text-style: bold;
}

#permission-subtitle {
    height: 1;
    margin-bottom: 1;

    color: #64748b;
}

#permission-options {
    height: auto;
    padding: 0 0 1 0;

    color: #cbd5e1;
}

#permission-footer {
    height: 1;
    margin-top: 1;

    color: #475569;
    content-align: center middle;
}


/* =========================================================
   PERMISSION APPROVAL DIALOG
   Appears when Jimmy needs approval for a risky tool.
   ========================================================= */

#approval-dialog {
    width: 66;
    height: auto;
    min-height: 13;
    padding: 1 2;

    background: #0b1220;
    border: round #f59e0b;
}

#approval-title {
    height: 1;
    margin-bottom: 1;

    color: #f8fafc;
    text-style: bold;
}

#approval-tool {
    height: auto;
    padding: 1;
    margin-bottom: 1;

    background: #111827;
    color: #cbd5e1;
}

#approval-reason {
    height: auto;
    margin-bottom: 1;

    color: #94a3b8;
}


/* =========================================================
   APPROVAL BUTTON ROW
   ========================================================= */

#approval-actions {
    height: 3;
    align: center middle;
}


/* Allow */

#approval-allow {
    width: 20;
    height: 3;
    margin-right: 1;

    background: #14532d;
    color: #dcfce7;

    content-align: center middle;
    text-style: bold;
}


/* Deny */

#approval-deny {
    width: 20;
    height: 3;
    margin-right: 1;

    background: #3f1d1d;
    color: #fecaca;

    content-align: center middle;
    text-style: bold;
}


/* Full Access */

#approval-full {
    width: 20;
    height: 3;

    background: #1e293b;
    color: #fde68a;

    content-align: center middle;
    text-style: bold;
}


/* =========================================================
   APPROVAL FOOTER
   ========================================================= */

#approval-footer {
    height: 1;
    margin-top: 1;

    color: #475569;
    content-align: center middle;
}


/* =========================================================
   BUTTON HOVER / FOCUS
   Gives the approval UI better mouse + keyboard feedback.
   ========================================================= */

#approval-allow:hover,
#approval-allow:focus {
    background: #166534;
}

#approval-deny:hover,
#approval-deny:focus {
    background: #7f1d1d;
}

#approval-full:hover,
#approval-full:focus {
    background: #334155;
    color: #fef3c7;
}


/* =========================================================
   PERMISSION MODE HOVER / FOCUS
   ========================================================= */

#permission-options:hover {
    color: #f8fafc;
}


/* =========================================================
   KEEP DIALOGS COMPACT
   No fullscreen panel or large overlay box.
   ========================================================= */

PermissionScreen > Vertical,
PermissionPrompt > Vertical {
    height: auto;
}