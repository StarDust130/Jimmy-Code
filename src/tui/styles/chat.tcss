/* ─────────────────────────────────────────
   chat.tcss — ChatLog (components/chat.py)
   the scrolling transcript
   ───────────────────────────────────────── */

ChatLog {
    height: 1fr;                    /* fills space between bar & composer */
    padding: 1 2 0 2;               /* aligns with the composer margins */
    scrollbar-size: 1 1;            /* thin, quiet scrollbar */
    scrollbar-color: #23252e;
    scrollbar-background: #0e0f13;
}