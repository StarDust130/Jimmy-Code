/* ──────────────────────────────────────────────────────
   composer.tcss — Composer (components/composer.py)
   Claude-style input: rounded box + hint line beneath
   ────────────────────────────────────────────────────── */

Composer {
    height: auto;
    padding: 0 2 1 2;               /* side margins match chat; air below */
}

/* The rounded shell IS the input's own border. */
#prompt {
    border: round #23252e;
    background: #15161d;            /* surface */
}

/* Lights up violet while you type. */
#prompt:focus {
    border: round #b392f8;          /* accent */
}

/* Placeholder text */
#prompt > .input--placeholder {
    color: #5f626b;                 /* faint */
}

/* Caret — accent block */
#prompt > .input--cursor {
    background: #b392f8;
    color: #0e0f13;
}

/* Dim cheat-sheet line under the box */
#composer-hints {
    height: 1;
    padding: 0 1;
    color: #5f626b;                 /* faint */
}