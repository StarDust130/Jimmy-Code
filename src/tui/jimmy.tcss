/* =========================================================
   JIMMY
   Compact terminal-native UI
   ========================================================= */

Screen {
    background: #0b0d12;
    color: #d9dce5;
}


/* ─────────────────────────────────────────────
   TOP BAR
   ───────────────────────────────────────────── */

TopBar {
    height: 1;
    width: 100%;
    padding: 0 1;
    background: #11141b;
}

#brand {
    color: #c084fc;
    text-style: bold;
}

#brand-model {
    color: #727887;
    padding-left: 1;
}

#top-spacer {
    width: 1fr;
}

#state {
    color: #a0a5b2;
}

.state-ready {
    color: #6ee7b7;
}

.state-thinking {
    color: #c084fc;
}

.state-error {
    color: #fb7185;
}

.state-interrupted {
    color: #fbbf24;
}


/* ─────────────────────────────────────────────
   CHAT
   ───────────────────────────────────────────── */

ChatLog {
    width: 100%;
    height: 1fr;

    padding: 1 2;

    background: #0b0d12;

    scrollbar-size: 1 1;
}


/* ─────────────────────────────────────────────
   MESSAGE
   ───────────────────────────────────────────── */

.msg {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0;
}

.marker {
    width: auto;
    height: 1;
    color: #c084fc;
    text-style: bold;
}

.body {
    width: 100%;
    height: auto;
    padding-left: 2;
    color: #d9dce5;
}


/* ─────────────────────────────────────────────
   USER
   ───────────────────────────────────────────── */

.msg-user .marker {
    color: #60a5fa;
}

.msg-user .body {
    color: #aeb4c2;
}


/* ─────────────────────────────────────────────
   ASSISTANT
   ───────────────────────────────────────────── */

.msg-assistant .marker {
    color: #c084fc;
}

.msg-assistant .body {
    color: #e2e4eb;
}


/* ─────────────────────────────────────────────
   ERROR
   ───────────────────────────────────────────── */

.msg-error {
    margin-top: 1;
}

.msg-error .marker {
    color: #fb7185;
}

.msg-error .body {
    color: #fda4af;
}


/* ─────────────────────────────────────────────
   SYSTEM
   ───────────────────────────────────────────── */

.msg-system {
    height: 1;
    margin: 0;
}

.msg-system .marker {
    color: #6b7280;
}


/* ─────────────────────────────────────────────
   ACTIVITY
   ───────────────────────────────────────────── */

.activity-row {
    width: 100%;
    height: 1;

    margin: 0 0 1 2;
    padding: 0;

    color: #818897;
}


/* ─────────────────────────────────────────────
   COMPOSER
   ───────────────────────────────────────────── */

Composer {
    width: 100%;
    height: auto;

    padding: 0 2 1 2;

    background: #0b0d12;
}

#prompt {
    width: 100%;
    height: 3;

    background: #11141b;

    border: round #343946;

    color: #e5e7eb;

    padding: 0 1;
}

#prompt:focus {
    border: round #8b5cf6;
}

#composer-hints {
    width: 100%;
    height: 1;

    padding: 0 1;

    color: #555b69;
}