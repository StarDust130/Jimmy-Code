Screen {
    background: #0b0d12;
    color: #d9dce5;
}


/* ─────────────────────────────────────
   TOP BAR
   ───────────────────────────────────── */

TopBar {
    width: 100%;
    height: 1;
    padding: 0 1;

    background: #11141b;
}

#brand {
    color: #c084fc;
    text-style: bold;
}

#brand-model {
    color: #737a8a;
    padding-left: 1;
}

#top-spacer {
    width: 1fr;
}

#state {
    color: #9da3b2;
}

.state-ready {
    color: #6ee7b7;
}

.state-thinking {
    color: #c084fc;
}

.state-error {
    color: #fb7185;
}

.state-interrupted {
    color: #fbbf24;
}


/* ─────────────────────────────────────
   CHAT
   ───────────────────────────────────── */

ChatLog {
    width: 100%;
    height: 1fr;

    padding: 0 2 1 2;

    background: #0b0d12;

    scrollbar-size: 1 1;
}


/* ─────────────────────────────────────
   MESSAGES
   ───────────────────────────────────── */

.msg {
    width: 100%;
    height: auto;

    margin: 0;
    padding: 0;

    opacity: 0;
}

.msg-user {
    margin-bottom: 1;
}

.msg-assistant {
    margin-bottom: 1;
}

.marker {
    width: auto;
    height: 1;

    text-style: bold;
}

.body {
    width: 100%;
    height: auto;

    padding-left: 2;

    color: #dce0e8;
}


.msg-user .marker {
    color: #60a5fa;
}

.msg-user .body {
    color: #aeb4c2;
}

.msg-assistant .marker {
    color: #c084fc;
}

.msg-assistant .body {
    color: #e3e6ed;
}


.msg-error {
    height: auto;
    margin: 1 0;
}

.msg-error .marker {
    color: #fb7185;
}

.msg-error .body {
    color: #fda4af;
}


.msg-system {
    height: 1;
    margin: 0;
}

.msg-system .marker {
    color: #6b7280;
}


/* ─────────────────────────────────────
   MODEL STATUS
   ───────────────────────────────────── */

.live-model-status {
    width: 100%;
    height: 1;

    margin: 0;
    padding-left: 2;
}


/* ─────────────────────────────────────
   TOOL STATUS
   ───────────────────────────────────── */

.live-tool-status {
    width: 100%;
    height: 1;

    margin: 0;
    padding-left: 2;
}


/* ─────────────────────────────────────
   COMPOSER
   ───────────────────────────────────── */

Composer {
    width: 100%;
    height: auto;

    padding: 0 2 1 2;

    background: #0b0d12;
}

#prompt {
    width: 100%;
    height: 3;

    padding: 0 1;

    background: #11141b;

    border: round #343946;

    color: #e5e7eb;
}

#prompt:focus {
    border: round #8b5cf6;
}

#composer-hints {
    width: 100%;
    height: 1;

    padding: 0 1;

    color: #555b69;
}