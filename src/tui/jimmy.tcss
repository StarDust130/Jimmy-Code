/* ═════════════════════════════════════════════════════════════════════
   Jimmy Code — jimmy.tcss
   Retro arcade × synthwave × cyber terminal × premium developer tool.

   Themes are driven from app.py (THEME dict + rebuilt flow palette) so
   the wordmark / waves / accents change LIVE; the CSS below keeps the
   structural palette constant across themes.  Palette rows carry
   explicit inline colors in app.py — the colors here are fallbacks.

   FREEZE FIX (unchanged): the palette has NO transitions and NO opacity
   animation — static open/close, zero animation races.
   ═════════════════════════════════════════════════════════════════════ */

Screen {
    background: #090b12;
    color: #e2e6f2;
    align: center top;
}

/* ── Top navbar ───────────────────────────────────────────────────── */

#top-bar {
    width: 100%;
    max-width: 132;
    height: 2;
    padding: 0 1;
    background: #0c0f18;
    border-bottom: solid #1a2036;
}

#top-left {
    width: 1fr;
    height: 1;
}

#top-left:hover {
    background: #10141f;
}

#chip-tokens,
#chip-state,
#chip-sound {
    width: auto;
    height: 1;
    padding: 0 1;
}

#chip-tokens {
    color: #fb7185;                  /* Σ shown in red */
}

#chip-sound {
    margin-left: 1;
}

#chip-state:hover,
#chip-sound:hover {
    background: #161c30;
}

/* ── Timeline ─────────────────────────────────────────────────────── */

ChatLog {
    width: 100%;
    max-width: 132;
    height: 1fr;
    padding: 1 2;
    align: center top;
    background: #090b12;
    overflow-x: hidden;
    scrollbar-size: 1 1;
    scrollbar-color: #232838;
}

.msg {
    width: 100%;
    max-width: 120;
    height: auto;
}

.msg-user {
    margin-top: 1;
    margin-bottom: 1;
    padding-left: 1;
}

.msg-assistant {
    margin-bottom: 1;
    padding-left: 1;
}

.assistant-body {
    width: 100%;
    height: auto;
    padding-right: 1;
    color: #e9ecf7;
    overflow-x: auto;
}

.pair-divider {
    width: 100%;
    max-width: 120;
    height: 1;
    border-top: solid #161b2c;
    margin-top: 1;
    margin-bottom: 1;
}

.thinking-row {
    width: 100%;
    max-width: 120;
    height: 1;
    padding-left: 1;
}

.live-tool-status {
    width: 100%;
    max-width: 120;
    height: 1;
    padding-left: 1;
}

.live-tool-status:hover {
    background: #0d1120;
}

.turn-summary {
    width: 100%;
    max-width: 120;
    height: auto;
    padding-left: 1;
    margin-bottom: 1;
}

.turn-summary:hover {
    background: #0d1120;
}

/* ── Error card ───────────────────────────────────────────────────── */

.error-card {
    width: 100%;
    max-width: 120;
    height: auto;
    border: round #5b2733;
    background: #120d13;
    padding: 0 1;
    margin: 1 0;
}

.err-title {
    width: 100%;
    height: 1;
}

.err-msg {
    width: 100%;
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
}

.err-actions {
    width: 100%;
    height: 1;
}

#err-retry {
    width: auto;
    height: 1;
    padding: 0 1;
}

#err-retry:hover {
    background: #2a1420;
}

#err-details {
    width: auto;
    height: 1;
    padding: 0 1;
    margin-left: 1;
}

#err-details:hover {
    background: #191019;
}

.err-detail {
    display: none;
    width: 100%;
    height: auto;
    color: #c98a97;
    padding: 1 1 0 1;
}

.err-detail.shown {
    display: block;
}

.msg-system {
    width: 100%;
    max-width: 120;
    height: auto;
    padding-left: 1;
    color: #4b5163;
    text-style: italic;
}

.empty-state {
    width: 100%;
    max-width: 120;
    height: auto;
    text-align: center;
    margin-top: 3;
    color: #565d73;
}

/* ═══════════════════════════════════════════════
   COMPOSER
   ═══════════════════════════════════════════════ */


Composer {
    width: 100%;
    max-width: 132;

    height: auto;

    padding: 0 0 0 0;

    background: #080B10;
}

#prompt {
    width: 100%;
    height: 3;

    padding: 0 1;

    background: #0D1219;

    border: round #263241;

    color: #E8ECF4;
}

#prompt:focus {
    background: #101621;
    border: round #8B7CF6;
}

#composer.busy #prompt {
    background: #0C1118;
    border: round #303A49;
}

#composer.celebrate #prompt {
    background: #0D1813;
    border: round #34D399;
}


/* ─────────────────────────────────────────────
   SHORTCUT RAIL
   ───────────────────────────────────────────── */

#composer-hints {
    width: 100%;
    height: 1;

    margin-top: 0;
    padding: 0;

    text-align: center;

    color: #566170;
}


/* ═══════════════════════════════════════════════
   TOASTS
   ═══════════════════════════════════════════════ */

ToastRack {
    align: left bottom;

    width: 100%;
    height: auto;
}

Toast {
    width: auto;
    max-width: 46;

    height: 3;

    margin: 0 0 1 1;
    padding: 0 1;

    background: #101620;
    color: #D8DEE9;

    border: round #263241;
}

Toast.-information {
    border: round #5666A8;
}

Toast.-warning {
    border: round #F5C451;
}

Toast.-error {
    border: round #FB7185;
}

/* ── Command palette (ctrl+p) — small, floating, centered, static ─── */

CommandPaletteScreen {
    align: center middle;
    background: #05060a 78%;         /* dim scrim — click it to close */
}

#palette {
    width: 68;
    max-width: 92%;                  /* small terminals: still centered */
    height: auto;
    max-height: 30;
    background: #0d1017;
    border: round #2a3148;
    padding: 0 1 1 1;
    /* No opacity, no transition — instant open/close, zero freeze risk. */
}

#palette-head {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #10141f;
    border-bottom: solid #1a2036;
}

#palette-title {
    width: 1fr;
    height: 1;
    color: #e2e6f2;
    text-style: bold;
}

#palette-esc {
    width: auto;
    height: 1;
}

#palette-close {
    width: auto;
    height: 1;
    padding: 0 1;
    margin-left: 1;
    color: #aab2c7;
}

#palette-close:hover {
    background: #2a1420;
    color: #fda4af;
}

#palette-search {
    width: 100%;
    height: 3;
    margin-top: 1;
    padding: 0 1;
    background: #0f1322;
    border: round #2a3148;
    color: #e7eaf3;
}

#palette-search:focus {
    border: round #8b5cf6;
    background: #12162b;
}

#palette-section {
    width: 100%;
    height: 1;
    padding: 0 1;
    margin-top: 1;
    color: #8a91a8;
    text-style: bold;
}

#palette-list {
    width: 100%;
    height: auto;
    max-height: 18;
    overflow-y: auto;
}

.palette-item {
    width: 100%;
    height: 1;
    padding: 0 1;
    color: #dbe0ee;                  /* fallback only — rows carry inline
                                        explicit colors (app.py) */
}

.palette-item:hover {
    background: #131a30;
}

.palette-item.selected {
    background: #1c2440;
    text-style: bold;
}

#palette-foot {
    width: 100%;
    height: 1;
    padding: 0 1;
    margin-top: 1;
    border-top: solid #1a2036;
    color: #6a7188;
}

/* ── Home ─────────────────────────────────────────────────────────── */

HomeScreen {
    background: #080a10;
    layers: main fx;
    overflow-x: hidden;
    overflow-y: auto;
}

#home-scan {
    position: absolute;
    width: 100%;
    height: 1;
    layer: fx;
    visibility: hidden;
}

#home-scan.on {
    visibility: visible;
}

#home-top {
    width: 100%;
    height: 1;
    padding: 0 2;
    layer: main;
}

#home-top-brand {
    width: 1fr;
    height: 1;
}

#home-top-sound {
    width: auto;
    height: 1;
    padding: 0 1;
}

#home-top-sound:hover {
    background: #131a30;
}

#home-center {
    width: 100%;
    height: 1fr;
    align: center middle;
    layer: main;
    overflow-y: auto;
}

#hero {
    width: 100%;
    max-width: 64;      
}

#home-sparkles {
    width: 100%;
    height: 1;
    text-align: center;
    margin-bottom: 1;
}

#home-logo {
    width: 100%;
    height: auto;
    text-align: center;
    margin-bottom: 1;
}

#home-wave {
    width: 100%;
    height: 1;
    text-align: center;
    margin-bottom: 1;
}

#home-sub {
    width: 100%;
    height: 1;
    text-align: center;
}

#home-tagline {
    width: 100%;
    height: 1;
    text-align: center;
    margin-top: 1;
}

#home-prompt {
    width: 100%;
    height: 3;
    margin-top: 2;
    padding: 0 1;
    background: #0f1322;
    border: round #2a3148;
    color: #e7eaf3;
}

#home-prompt:focus {
    border: round #8b5cf6;
    background: #12162b;
}

#home-chips {
    width: 100%;
    height: 1;
    align: center middle;
    margin-top: 1;
}

.chip {
    width: auto;
    height: 1;
    padding: 0 1;
    margin: 0 1;
    color: #7c86ad;
}

.chip:hover {
    background: #131a30;
    color: #e7eaf3;
    text-style: bold;
}

#home-hints {
    width: 100%;
    height: 1;
    text-align: center;
    color: #565d73;
    margin-top: 1;
}

#home-statusbar {
    width: 100%;
    height: 1;
    padding: 0 2;
    layer: main;
}

#home-pwd {
    width: 1fr;
    height: 1;
}

#home-ver {
    width: auto;
    height: 1;
}

#home-bottom-wave {
    width: 100%;
    height: 1;
    padding: 0;
    layer: main;
}

.hidden-until {
    visibility: hidden;
}

/* ═══════════════════════════════════════════════
   🤖 MODEL PICKER — wizard (provider → model → key)
   ═══════════════════════════════════════════════ */

ModelScreen {
    align: center middle;
    background: #05060a 78%;
}

#model-card {
    width: 78;
    max-width: 92%;
    height: auto;
    max-height: 38;
    background: #0d1017;
    border: round #2a3148;
    padding: 0 1 1 1;
}

/* header */

#model-head {
    width: 100%;
    height: 1;
    padding: 0 1;
    background: #10141f;
    border-bottom: solid #1a2036;
}

#model-title {
    width: 1fr;
    height: 1;
    color: #e2e6f2;
    text-style: bold;
}

#model-esc {
    width: auto;
    height: 1;
}

/* 🧭 breadcrumb + stepper */

#model-crumb {
    width: 100%;
    height: 1;
    padding: 0 1;
    margin-top: 1;
    color: #7b8296;
}

#model-steps {
    width: 100%;
    height: 1;
    padding: 0 1;
    color: #565d73;
}

/* context line (hero stats / provider label) */

#model-section {
    width: 100%;
    height: 1;
    padding: 0 1;
    margin-top: 1;
    color: #8a91a8;
}

#model-search {
    display: none;
    width: 100%;
    height: 3;
    margin-top: 1;
    padding: 0 1;
    background: #0f1322;
    border: round #2a3148;
    color: #e7eaf3;
}

#model-search:focus {
    border: round #8b5cf6;
    background: #12162b;
}

#model-list {
    width: 100%;
    height: auto;
    max-height: 18;
    margin-top: 1;
}

.model-row {
    width: 100%;
    height: 1;
    padding: 0 1;
    color: #dbe0ee;
}

.model-row:hover {
    background: #131a30;
}

.model-row.selected {
    background: #1c2440;
    text-style: bold;
}

/* 🔑 key step */

#model-key {
    display: none;
    width: 100%;
    height: auto;
    padding: 0 1;
    margin-top: 1;
}

#model-fullname {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

#model-key-hint {
    width: 100%;
    height: auto;
    margin-top: 1;
}

#model-key-row {
    width: 100%;
    height: auto;
}

#model-in-key {
    width: 1fr;
    height: 3;
    margin-top: 1;
    background: #0f1322;
    border: round #2a3148;
    color: #e7eaf3;
}

#model-in-key:focus {
    border: round #34d399;
    background: #101a14;
}

#model-eye {
    width: auto;
    height: 1;
    padding: 0 1;
    margin-top: 2;
    margin-left: 1;
    color: #8a91a8;
}

#model-eye:hover {
    background: #131a30;
}

#model-form-msg {
    width: 100%;
    height: auto;
    margin-top: 1;
    color: #565d73;
}

#model-form-actions {
    width: 100%;
    height: auto;
    margin-top: 1;
}

.model-btn {
    width: auto;
    height: 3;
    padding: 0 2;
    margin-right: 1;
    background: #1b2033;
    border: round #2a3148;
    color: #dbe0ee;
}

.model-btn:hover {
    background: #232a45;
    color: #f5f6fc;
}

#model-save {
    border: round #2f6f4f;
    color: #34d399;
}

#model-save:hover {
    background: #12271c;
}

#model-refresh {
    border: round #2a3148;
    color: #8a91a8;
}

#model-refresh:hover {
    background: #1b2033;
    color: #e2e6f2;
}

/* contextual footer */

#model-foot {
    width: 100%;
    height: 1;
    padding: 0 1;
    margin-top: 1;
    border-top: solid #1a2036;
    color: #565d73;
}